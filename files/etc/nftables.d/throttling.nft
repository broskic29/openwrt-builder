
set high_speed_users {
	type ether_addr
	flags dynamic
}

set throttled_users {
	type ether_addr
	flags dynamic
}

chain throttling_forward {
	type filter hook forward priority mangle; policy accept;

	# Mark all members of the high_speed_users set with 0x20
	ether saddr @high_speed_users meta mark set 0x20

	# Mark all members of the throttled_users set with 0x10
	ether saddr @throttled_users meta mark set 0x10
}